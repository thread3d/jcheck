#!/usr/bin/env bash
# Thin client launcher. Prefers the built jar, falls back to the classes directory.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# jcheck's classes need JDK 17 or newer; a clear message beats UnsupportedClassVersionError.
JAVA_MAJOR="$(java -version 2>&1 | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -1)"
if [ "$JAVA_MAJOR" = "1" ]; then
  JAVA_MAJOR="$(java -version 2>&1 | sed -nE 's/.*version "1\.([0-9]+).*/\1/p' | head -1)"
fi
if [ -n "$JAVA_MAJOR" ] && [ "$JAVA_MAJOR" -lt 17 ]; then
  echo "jcheck: needs JDK 17 or newer to run (found $JAVA_MAJOR)." >&2
  echo "        Java 8 and 11 projects are checked with --release on a newer JDK." >&2
  exit 2
fi

if [ -f "$here/out/jcheck.jar" ]; then
  exec java -cp "$here/out/jcheck.jar" jcheck.cli.Main "$@"
fi

if [ -d "$here/out/classes" ]; then
  exec java -cp "$here/out/classes" jcheck.cli.Main "$@"
fi

echo "jcheck: not built yet; run ./build.sh" >&2
exit 2
