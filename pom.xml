<?xml version="1.0" encoding="UTF-8"?>
<!--
  A build descriptor for tools that know only Maven.

  jcheck's own build is ./build.sh: plain javac, no third-party compile dependencies, no network,
  and a support jar beside the main one. This file exists for a different reader - a verifier that
  can only drive Maven or Gradle (CodeWitness) - so the tree can be compiled, tested against
  declared scenarios, and reported on without changing how jcheck itself is built.

  It adds nothing to the artifact: there are no compile or runtime dependencies, and no plugins
  except Surefire, which exists only to run tests a verifier generates. The JUnit dependency is
  test scope and is there for the same reason; tests/run.sh still needs only a JDK and remains
  jcheck's own suite.

  The release level is the floor README.md states (JDK 17). build.sh compiles with the running JDK,
  so this file must not be read as the canonical source of compiler flags: the analyser flags, the
  release matrix and the support jar all live in build.sh and in specs/SPEC.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.jcheck</groupId>
  <artifactId>jcheck</artifactId>
  <version>1.4.0</version>
  <packaging>jar</packaging>
  <name>jcheck</name>
  <description>A Rust-style feedback layer for Java</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Test scope only: the harness a verifier writes its scenarios into. jcheck's own suite is
         tests/run.sh and needs no dependency at all. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
